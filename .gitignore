# ==========================================
# Evennia Runtime & Secrets
# ==========================================
# Secret settings contains sensitive cryptographic keys and database credentials
server/conf/secret_settings.py

# Local SQLite databases (default for local development)
server/evennia.db3
*.db
*.db3
*.sqlite3
*.sqlite3-journal

# Server log files and PID / socket / restart files
server/logs/
server/*.log
server/*.pid
server/*.sock
*.restart

# Collected static, uploaded media, and world cache (generated, volume-mounted at runtime)
server/.static/
server/.media/
server/.cache/
server/.art/

# Vue SPA build output (generated by `npm run build` in CI, browser workspaces,
# and the container image; never committed — stable names, design D2)
web/static/webclient/app/dist/

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*.so

.venv/
venv/
env/

# Environment files
.env
.env.local
.env.*.local

# ==========================================
# Tests, Coverage & Translations
# ==========================================
.coverage*
coverage-*
coverage.json
coverage.xml
.tox
toolbox/*.lock
*.mo

# ==========================================
# Frontend (npm toolchain, dev/CI-time only)
# ==========================================
node_modules/
.storybook-out/
# Showcase build lock: lives outside .storybook-out so a rebuild's
# directory wipe cannot unlink the locked inode (sees _showcase_build.py).
.storybook-out.lock

# ==========================================
# CodeGraph
# ==========================================
# Local codegraph index (SQLite + runtime metadata); rebuilt by `codegraph init`
.codegraph/

# ==========================================
# Misc
# ==========================================
tmp/
.superpowers/
*.swp

# ==========================================
# IDEs & System Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/worktrees/
.worktrees/
