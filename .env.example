# =============================================================================
# Elosern MUD — environment template
# =============================================================================
# Usage:  cp .env.example .env   (the real .env is gitignored)
#
# Who reads this file:
#   * podman/docker compose loads .env for ${VAR:-default} interpolation in
#     compose.yaml, and the evennia service declares `env_file: .env`, so every
#     active entry here is injected into the container environment at boot.
#   * The Python runtime reads ONLY the variables explicitly documented below
#     (grep for os.environ in server/conf/, world/, web/). Evennia has no
#     settings-from-env mapping: every other knob is a settings.py value, and
#     real secrets belong in server/conf/secret_settings.py, NOT in this file.
#   * Bare-metal (non-container) runs export the same variables in the shell;
#     the names and defaults below apply unchanged.
#
# Section legend:
#   [serve]   affects the running game server
#   [compose] consumed by compose.yaml interpolation / build, not the app
#   [test]    local or CI test runs; leave commented out when serving
#   [harness] managed browser-test harness (CI-managed; override to debug)
# =============================================================================

# -----------------------------------------------------------------------------
# External AI services [serve]
# -----------------------------------------------------------------------------
# Both are OPTIONAL by design: the deterministic game stays fully playable with
# every generative service offline (LLM layers degrade to authored fallbacks,
# art records stay pending with truthful placeholders).

# Ollama OpenAI-compatible endpoint used for every LLM layer
# (world/ai/profiles.py -> default_profiles() -> LLM_PROFILES base_url).
# Unset (bare metal): http://127.0.0.1:11434
# Compose default:     http://host.containers.internal:11434
# Point this at any OpenAI-compatible /v1/chat/completions server to replace
# Ollama; per-layer model/temperature/max_tokens overrides live in
# LLM_PROFILES (server/conf/settings.py or secret_settings.py).
#OLLAMA_BASE_URL=http://host.containers.internal:11434

# AUTOMATIC1111 sd-webui / Forge API root (server/conf/settings.py ->
# ART_SD_BASE_URL). Unset (bare metal): http://127.0.0.1:7860
# Compose default:            http://host.containers.internal:7860
#SD_WEBUI_BASE_URL=http://host.containers.internal:7860

# -----------------------------------------------------------------------------
# Prompt library [serve] + [compose]
# -----------------------------------------------------------------------------
# PROMPT_ROOT is the ROOT-INTERNAL path the app reads prompts from
# (server/conf/settings.py, world/prompts/loader.py). Unset: <GAME_DIR>/prompts
# — the tree baked into the image. Only set it for bare-metal or nonstandard
# layouts; do NOT point it at a host path inside the container.
#PROMPT_ROOT=/app/prompts

# PROMPTS_DIR is the HOST-side directory compose bind-mounts read-only onto
# /app/prompts (compose.yaml), so admins can edit prompts without rebuilding.
# Relative paths resolve against the compose project root.
#PROMPTS_DIR=./prompts

# -----------------------------------------------------------------------------
# Superuser bootstrap [serve]
# -----------------------------------------------------------------------------
# Evennia's launcher creates Account #1 non-interactively from these three
# vars when the database is empty. If they are absent (or the password is
# empty) on a fresh volume, the launcher falls back to an interactive prompt
# inside the container and crash-loops (RecursionError). The values below are
# the compose defaults; CHANGE THEM before any non-local deployment.
# Only ever applied on a brand-new database — later edits do nothing until the
# evennia-db volume is destroyed.
EVENNIA_SUPERUSER_USERNAME=browserplayer
EVENNIA_SUPERUSER_EMAIL=browser@example.test
#EVENNIA_SUPERUSER_PASSWORD=Elosern…026

# -----------------------------------------------------------------------------
# sd-webui generation tuning — NOT environment variables!
# -----------------------------------------------------------------------------
# Only SD_WEBUI_BASE_URL above is read from the environment. The remaining
# ART_SD_* knobs are plain Evennia settings (server/conf/settings.py, defaults
# 96-124; reference table in docs/gm/prompts.md). Setting ART_SD_STEPS,
# ART_SD_CHECKPOINT, ART_SD_SCENE_WIDTH, ART_SD_PREPIN_SAMPLES_FORMAT, etc.
# HERE HAS NO EFFECT — override them in server/conf/secret_settings.py
# (`from server.conf.settings import *` is NOT needed; it imports after).
# Settings-owned knobs: ART_SD_STEPS, ART_SD_CFG_SCALE, ART_SD_SAMPLER,
# ART_SD_SCHEDULER, ART_SD_CHECKPOINT, ART_SD_SCENE_WIDTH/HEIGHT,
# ART_SD_PORTRAIT_WIDTH/HEIGHT, ART_SD_TIMEOUT_SECONDS, ART_SD_CLIENT,
# ART_SD_MAX_RESPONSE_BYTES, ART_SD_MAX_IMAGE_DIMENSIONS,
# ART_SD_MAX_IMAGE_PIXELS, ART_SD_PREPIN_SAMPLES_FORMAT, ART_STORE_ROOT,
# ART_SCHEDULER_ENABLED/INTERVAL_SECONDS/LIMIT.

# -----------------------------------------------------------------------------
# Networking [serve]
# -----------------------------------------------------------------------------
# Ports are fixed in the image/compose mapping (4000 telnet, 4001 webclient
# HTTP, 4002 websocket) and are not environment-configurable.
# If the webclient is reached through a proxy or a remapped port, Evennia
# embeds WEBSOCKET_CLIENT_PORT into the page; override ONLY the front-facing
# value here (read by evennia.web.utils.general_context). Unset = 4002.
#WEBSOCKET_CLIENT_PROXY_PORT=4002

# Django's SECRET_KEY is NOT read from the environment on this project.
# Generate one and put it in server/conf/secret_settings.py
# (imported by server/conf/settings.py), along with ALLOWED_HOSTS or any
# LLM_PROFILES overrides. A missing secret_settings.py is tolerated in dev.

# -----------------------------------------------------------------------------
# Container build / image metadata [compose]
# -----------------------------------------------------------------------------
# Build ARGs and image tag interpolated by compose.yaml.

# UID/GID the final image runs as (non-root, arbitrary-UID design).
#CONTAINER_UID=1001

# OCI image tag for localhost/elosern-mud:<tag>.
#IMAGE_TAG=edge

# OCI version/release labels baked at build time.
#VERSION=EDGE
#RELEASE=0

# -----------------------------------------------------------------------------
# Local Evennia test runs [test]
# -----------------------------------------------------------------------------
# server/conf/test_settings.py refuses to import unless BOTH conditions hold:
# MUD_TEST_SETTINGS=1 and argv starts with `test`. Set it per-invocation
# (`MUD_TEST_SETTINGS=1 uv run --locked evennia test ...`), not in a file that
# the server boots with.
#MUD_TEST_SETTINGS=1

# TEST_DB_PATH is the only other env Evennia itself reads (test database name
# default in settings_default.py); server/conf/test_settings.py overrides it
# unconditionally to server/db/evennia-test.sqlite3, so it is inert here.

# Set automatically by the evennia launcher / test bootstraps; exporting it
# manually is only needed by raw-Django scripts (tests/test_command_docs.py
# uses setdefault, so leave this commented in .env).
#DJANGO_SETTINGS_MODULE=server.conf.settings

# -----------------------------------------------------------------------------
# Spec traceability / coverage (CI-owned) [test]
# -----------------------------------------------------------------------------
# OPENSPEC_TEST_EVIDENCE (tools/spec_traceability): when set to a path, each
# @covers_requirement-annotated test appends a JSON evidence record there on
# pass. COVERAGE_FILE names the per-shard coverage data file. Both are set by
# .github/workflows/quality-gate.yml; local handoff uses
# `python -m tools.spec_traceability check` instead.
#OPENSPEC_TEST_EVIDENCE=evidence.local.jsonl
#COVERAGE_FILE=.coverage

# -----------------------------------------------------------------------------
# Managed browser-test harness [harness]
# -----------------------------------------------------------------------------
# web/tests/browser/ allocates a private DB/log/media/static/art root and a
# loopback port block (4100-4106) via these vars; the fixture helpers
# (fixtures.py/runtime) normally generate them per run, and the full managed
# suite is CI-owned. Override individually only when reproducing a single
# browser class locally. Values shown are the code defaults.

# Isolation roots and ports
#ELOSERN_BROWSER_DB=            # private SQLite path (never evennia.db3)
#ELOSERN_BROWSER_LOG_DIR=       # private log root
#ELOSERN_BROWSER_CACHE_DIR=
#ELOSERN_BROWSER_MEDIA_ROOT=
#ELOSERN_BROWSER_STATIC_ROOT=
#ELOSERN_BROWSER_ART_ROOT=      # private art store; also selects art fixtures
#ELOSERN_BROWSER_TELNET_PORT=4100
#ELOSERN_BROWSER_HTTP_PORT=4101
#ELOSERN_BROWSER_WS_PORT=4102
#ELOSERN_BROWSER_INTERNAL_PORT=4105
#ELOSERN_BROWSER_AMP_PORT=4106
#ELOSERN_BROWSER_SECRET_KEY=elosern-browser-test-key

# SD client seam: defaults to the deterministic fake (socket-free). Tests
# override it to e.g. web.tests.browser.fake_sd_client.FailingSDWebUIClient.
#ELOSERN_BROWSER_SD_CLIENT=world.art.fake_sd_client.FakeSDWebUIClient
#ELOSERN_BROWSER_SD_TIMEOUT=600

# Vue SPA vs legacy webclient: default Vue; =0 selects the legacy fallback.
#ELOSERN_BROWSER_VUE_CLIENT=1

# Seeded identities (passwords are fixed so Playwright can log in — local
# loopback only, never reuse these values for a deployed server).
#ELOSERN_BROWSER_ACCOUNT=browserplayer
#ELOSERN_BROWSER_PASSWORD=ElosernBrowserTest!2026
#ELOSERN_BROWSER_CHARACTER=BrowserTest
#ELOSERN_BROWSER_ROOM=測試起點
#ELOSERN_BROWSER_CREATION_ACCOUNT=browsercreator
#ELOSERN_BROWSER_CREATION_PASSWORD=CreationBrowserTest!2026

# Scenario switches consumed by web/tests/browser/seed.py:
#ELOSERN_BROWSER_ART=           # done | pending | missing (art record state)
#ELOSERN_BROWSER_SERVICES=      # services-panel fixture mode
#ELOSERN_BROWSER_EXPLORATION=1  # seed the exploration fixture
#ELOSERN_BROWSER_OPTIONS_SURFACE=1
#ELOSERN_BROWSER_TITLES=1       # seed nominated titles
#ELOSERN_BROWSER_CREATION=1     # pending-creation account fixture
#ELOSERN_BROWSER_CREATION_PRESET_DRAFT=1
#ELOSERN_BROWSER_CREATION_DRAFT=1
#ELOSERN_BROWSER_MINIMAP=1
